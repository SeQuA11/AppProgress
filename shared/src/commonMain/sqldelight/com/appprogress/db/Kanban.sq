-- Канбан: доски → колонки → карточки.
-- position — дробное число: чтобы вставить карточку между двумя, берём середину их позиций
-- и не переписываем позиции всех остальных карточек.
CREATE TABLE IF NOT EXISTS board (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    position REAL NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE TABLE IF NOT EXISTS board_column (
    id TEXT NOT NULL PRIMARY KEY,
    board_id TEXT NOT NULL,
    title TEXT NOT NULL,
    position REAL NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE INDEX IF NOT EXISTS board_column_board ON board_column(board_id);

CREATE TABLE IF NOT EXISTS card (
    id TEXT NOT NULL PRIMARY KEY,
    board_id TEXT NOT NULL,
    column_id TEXT NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    priority INTEGER NOT NULL DEFAULT 0, -- 0 нет, 1 низкий, 2 средний, 3 высокий
    due_date TEXT,                       -- ГГГГ-ММ-ДД
    labels TEXT NOT NULL DEFAULT '',     -- через запятую
    position REAL NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE INDEX IF NOT EXISTS card_board ON card(board_id);

selectBoards:
SELECT id, title, position FROM board WHERE deleted_at IS NULL ORDER BY position;

insertBoard:
INSERT INTO board(id, title, position, created_at, updated_at) VALUES (?, ?, ?, ?, ?);

renameBoard:
UPDATE board SET title = ?, updated_at = ? WHERE id = ?;

softDeleteBoard:
UPDATE board SET deleted_at = ?, updated_at = ? WHERE id = ?;

selectColumns:
SELECT id, board_id, title, position FROM board_column
WHERE board_id = ? AND deleted_at IS NULL ORDER BY position;

insertColumn:
INSERT INTO board_column(id, board_id, title, position, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?);

renameColumn:
UPDATE board_column SET title = ?, updated_at = ? WHERE id = ?;

softDeleteColumn:
UPDATE board_column SET deleted_at = ?, updated_at = ? WHERE id = ?;

softDeleteColumnsOfBoard:
UPDATE board_column SET deleted_at = ?, updated_at = ? WHERE board_id = ? AND deleted_at IS NULL;

selectCards:
SELECT id, board_id, column_id, title, description, priority, due_date, labels, position FROM card
WHERE board_id = ? AND deleted_at IS NULL ORDER BY position;

selectAllCards:
SELECT id, board_id, column_id, title, description, priority, due_date, labels, position FROM card
WHERE deleted_at IS NULL ORDER BY position;

selectCardsInColumn:
SELECT id, board_id, column_id, title, description, priority, due_date, labels, position FROM card
WHERE column_id = ? AND deleted_at IS NULL ORDER BY position;

insertCard:
INSERT INTO card(id, board_id, column_id, title, position, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?);

updateCard:
UPDATE card SET title = ?, description = ?, priority = ?, due_date = ?, labels = ?, updated_at = ? WHERE id = ?;

moveCard:
UPDATE card SET column_id = ?, position = ?, updated_at = ? WHERE id = ?;

softDeleteCard:
UPDATE card SET deleted_at = ?, updated_at = ? WHERE id = ?;

softDeleteCardsOfColumn:
UPDATE card SET deleted_at = ?, updated_at = ? WHERE column_id = ? AND deleted_at IS NULL;

softDeleteCardsOfBoard:
UPDATE card SET deleted_at = ?, updated_at = ? WHERE board_id = ? AND deleted_at IS NULL;
