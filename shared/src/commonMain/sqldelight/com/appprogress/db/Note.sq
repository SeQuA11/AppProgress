-- Заметки. Поля updated_at / deleted_at нужны будущей синхронизации между устройствами:
-- удаление «мягкое» (ставим deleted_at), чтобы другое устройство узнало, что заметку удалили.
-- IF NOT EXISTS: схема применяется при каждом запуске, см. DatabaseFactory.
CREATE TABLE IF NOT EXISTS note (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL DEFAULT '',
    content TEXT NOT NULL DEFAULT '',
    pinned INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE INDEX IF NOT EXISTS note_updated_at ON note(updated_at);

selectActive:
SELECT * FROM note
WHERE deleted_at IS NULL
ORDER BY pinned DESC, updated_at DESC;

selectById:
SELECT * FROM note WHERE id = ?;

insert:
INSERT INTO note(id, title, content, pinned, created_at, updated_at)
VALUES (?, ?, ?, 0, ?, ?);

updateText:
UPDATE note SET title = ?, content = ?, updated_at = ? WHERE id = ?;

setPinned:
UPDATE note SET pinned = ?, updated_at = ? WHERE id = ?;

softDelete:
UPDATE note SET deleted_at = ?, updated_at = ? WHERE id = ?;
